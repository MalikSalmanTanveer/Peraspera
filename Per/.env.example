# Supabase (Project Settings → API)
# Required for quote inquiries and careers (public reads + Edge Function calls)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role — local scripts only (seed). NEVER expose to the browser / VITE_*.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First Super Admin seed (npm run seed) — branch/dev only
# SEED_SUPER_ADMIN_EMAIL=you@example.com
# SEED_SUPER_ADMIN_PASSWORD=choose-a-strong-password
# SEED_SUPER_ADMIN_USERNAME=superadmin

# Resend — set as Supabase Edge Function secrets (NOT in frontend .env)
# RESEND_API_KEY=re_xxxx
# FROM_EMAIL=Peraspera <onboarding@resend.dev>
# NOTIFY_EMAIL=contact.peraspera@gmail.com

# Legacy shared admin login (removed on feature/admin-platform; keep only if still on old main)
# ADMIN_EMAIL=admin@peraspera.solutions
# ADMIN_PASSWORD=your-secure-password

# Local setup script only (quote notification deploy helper)
RESEND_API_KEY=re_xxxx
